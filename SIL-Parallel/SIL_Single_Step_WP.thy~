subsection \<open>Soundness and Completeness\<close>

theory SIL_Single_Step_WP
imports SIL_Single_Step
begin

definition wp_single :: "com \<Rightarrow> com \<Rightarrow> post \<Rightarrow> assn" where
  "wp_single c1 c2 R = (\<lambda>s. case R of
      OK Q \<Rightarrow> (\<exists>s'. (c1,sOK s) \<rightarrow> (c2,sOK s') \<and> Q s')
    | ER Q \<Rightarrow> (\<exists>s'. (c1,sOK s) \<rightarrow> (c2,sER s') \<and> Q s'))"


lemma wp_single_SKIP_OK: "wp_single SKIP c' (OK Q) =(\<lambda>s. False)"
  unfolding wp_single_def by fastforce

lemma wp_single_SKIP_ER: "wp_single SKIP c' (ER Q) =(\<lambda>s. False)"
  unfolding wp_single_def by fastforce

lemma wp_single_ABORT_OK: "wp_single ABORT c' (OK Q) =(\<lambda>s. False)"
  unfolding wp_single_def by fastforce

lemma wp_single_ABORT_ER: "wp_single ABORT c' (ER Q) = (\<lambda>s. c' = SKIP \<and> Q s)"
  unfolding wp_single_def by fastforce

lemma wp_single_Assign_OK: "wp_single (x ::= a) c' (OK Q) = 
  (\<lambda>s. c' = SKIP \<and> Q(s(x := aval a s)))"
  unfolding wp_single_def by fastforce

lemma wp_single_Assign_ER: "wp_single (x ::= a) c' (ER Q) =(\<lambda>s. False)"
  unfolding wp_single_def by fastforce

lemma wp_single_AssignND_OK: "A \<noteq> {} \<Longrightarrow> wp_single (x ::= ND A) c' (OK Q) = 
  (\<lambda>s. c' = SKIP \<and> (\<exists>a \<in> A. Q(s(x := aval a s))))"
  unfolding wp_single_def by fastforce

lemma wp_single_AssignND_Empty_OK: "wp_single (x ::= ND {}) c' (OK Q) = 
  (\<lambda>s. c' = ABORT \<and> Q s)"
  unfolding wp_single_def by fastforce

lemma wp_single_AssignND_ER: "wp_single (x ::= ND A) c' (ER Q) = (\<lambda>s. False)"
  unfolding wp_single_def by fastforce

lemma wp_single_Seq_OK: "wp_single (c\<^sub>1;;c\<^sub>2) c' (OK Q) = (\<lambda>s. case c\<^sub>1 of 
  SKIP \<Rightarrow> c' = c\<^sub>2 \<and> Q s
  | _ \<Rightarrow> \<exists>c\<^sub>1'. c' = c\<^sub>1';;c\<^sub>2 \<and> wp_single c\<^sub>1 c\<^sub>1' (OK Q) s)"
  apply (cases c\<^sub>1)
  unfolding wp_single_def by fastforce+

lemma wp_single_Seq_ER: "wp_single (c\<^sub>1;;c\<^sub>2) c' (ER Q) = (\<lambda>s. case c\<^sub>1 of 
  SKIP \<Rightarrow> False
  | _ \<Rightarrow> \<exists>c\<^sub>1'. c' = c\<^sub>1';;c\<^sub>2 \<and> wp_single c\<^sub>1 c\<^sub>1' (ER Q) s)"
  apply (cases c\<^sub>1)
  unfolding wp_single_def by fastforce+

lemma wp_single_If_True_OK: "wp_single (IF b THEN c\<^sub>1 ELSE c\<^sub>2) c' (OK Q) = 
  (\<lambda>s. if bval b s then c' = c\<^sub>1 \<and> Q s else c' = c\<^sub>2 \<and> Q s)"
  unfolding wp_single_def
  apply clarsimp
proof -
  have "\<forall>f. (Q f \<and> c\<^sub>2 = c' \<or> bval b f) \<and> (Q f \<and> c\<^sub>1 = c' \<or> \<not> bval b f) \<and> (\<exists>fa. Q fa \<and> (IF b THEN c\<^sub>1 ELSE c\<^sub>2, sOK f) \<rightarrow> (c', sOK fa)) \<or> ((\<not> Q f \<or> c\<^sub>2 \<noteq> c') \<and> \<not> bval b f \<or> (\<not> Q f \<or> c\<^sub>1 \<noteq> c') \<and> bval b f) \<and> (\<forall>fa. \<not> Q fa \<or> \<not> (IF b THEN c\<^sub>1 ELSE c\<^sub>2, sOK f) \<rightarrow> (c', sOK fa))"
    by blast
  then show "(\<lambda>f. \<exists>fa. (IF b THEN c\<^sub>1 ELSE c\<^sub>2, sOK f) \<rightarrow> (c', sOK fa) \<and> Q fa) = (\<lambda>f. (bval b f \<longrightarrow> c' = c\<^sub>1 \<and> Q f) \<and> (\<not> bval b f \<longrightarrow> c' = c\<^sub>2 \<and> Q f))"
    by fastforce
qed

lemma wp_single_If_True_ER: "wp_single (IF b THEN c\<^sub>1 ELSE c\<^sub>2) c' (ER Q) = (\<lambda>s. False)"
  unfolding wp_single_def
  by fastforce

lemma wp_single_While_OK: "wp_single (WHILE b DO c) c' (OK Q) = 
  (\<lambda>s. c' = IF b THEN c;;WHILE b DO c ELSE SKIP \<and> Q s)"
  unfolding wp_single_def by fastforce

lemma wp_single_While_ER: "wp_single (WHILE b DO c) c' (ER Q) = (\<lambda>s. False)"
  unfolding wp_single_def by fastforce

lemma wp_single_SelectND_OK[simp]:  "wp_single (SELECT S) c' (OK Q) =  (\<lambda>s. 
      (\<exists>(b,c) \<in> set S. (bval b s) \<and> c' = c \<and> Q s)
    \<or> (\<forall>(b,c) \<in> set S. \<not>bval b s \<and> c' = ABORT \<and> Q s))
"
proof-
  assume valid_path: "\<exists>(b,c) \<in> set S. (bval b s)"
  have "c' = c \<and> Q s"
qed
  


lemma wp_single_SelectND_ER[simp]:  "wp_single (SELECT S) c' (ER Q) = (\<lambda>s. False)"
  unfolding wp_single_def by fastforce

lemma wp_single_Par_OK: "wp_single (c\<^sub>1 || c\<^sub>2) c' (OK Q)= (\<lambda>s. 
      (c\<^sub>1 = SKIP \<and> c' = c\<^sub>2 \<and> Q s)
    \<or> (c\<^sub>2 = SKIP \<and> c' = c\<^sub>1 \<and> Q s)
    \<or> (\<exists>c\<^sub>1'. c' = c\<^sub>1'||c\<^sub>2 \<and> wp_single c\<^sub>1 c\<^sub>1' (OK Q) s) 
    \<or> (\<exists>c\<^sub>2'. c' = c\<^sub>1||c\<^sub>2' \<and> wp_single c\<^sub>2 c\<^sub>2' (OK Q) s))" 
  apply (cases c\<^sub>1)
  unfolding wp_single_def apply fastforce
  unfolding wp_single_def apply fastforce
  apply clarsimp
  unfolding wp_single_def apply blast
  apply clarsimp
  unfolding wp_single_def apply blast
  apply clarsimp
  unfolding wp_single_def apply blast
  apply clarsimp
  unfolding wp_single_def apply blast
  apply clarsimp
  unfolding wp_single_def apply blast
  apply clarsimp
  unfolding wp_single_def apply blast
  apply clarsimp
  unfolding wp_single_def apply blast
  done

lemma wp_single_Par_ER: "wp_single (c\<^sub>1 || c\<^sub>2) c' (ER Q)= (\<lambda>s. 
    (\<exists>c\<^sub>1'. c' = c\<^sub>1'||c\<^sub>2 \<and> wp_single c\<^sub>1 c\<^sub>1' (ER Q) s) 
    \<or> (\<exists>c\<^sub>2'. c' = c\<^sub>1||c\<^sub>2' \<and> wp_single c\<^sub>2 c\<^sub>2' (ER Q) s))" 
  apply (cases c\<^sub>1)
  unfolding wp_single_def apply fastforce
  unfolding wp_single_def apply fastforce
  apply clarsimp
  unfolding wp_single_def apply blast
  apply clarsimp
  unfolding wp_single_def apply blast
  apply clarsimp
  unfolding wp_single_def apply blast
  apply clarsimp
  unfolding wp_single_def apply blast
  apply clarsimp
  unfolding wp_single_def apply blast
  apply clarsimp
  unfolding wp_single_def apply blast
  apply clarsimp
  unfolding wp_single_def apply blast
  done

