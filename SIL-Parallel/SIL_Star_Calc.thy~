lemma subst_aexp_sound:
  "aval (subst_aexp e x a) s =
   aval e (s(x := aval a s))"
  apply (induction e arbitrary: s)
by fastforce+

lemma subst_bexp_sound:
  "bval (subst_bexp b x a) s =
   bval b (s(x := aval a s))"
proof(induction b arbitrary: s)
  case (Bc x)
  then show ?case by simp
next
  case (Not b)
  then show ?case by simp
next
  case (And b1 b2)
  then show ?case by simp
next
  case (Less x1a x2a)
  then show ?case
