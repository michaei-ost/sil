lemma wp_calc_AssignND_OK_fail:
  assumes
    "pred_sem p s"
    "x2 = a # list"
    "\<forall>v\<in>set list. \<not> pred_sem Q (s(x1 := aval v s))"
    "x \<in> set list"
    "(p, b) \<in> set (wp_calc (n)  w (x1 ::= x) (OK' Q))"
  shows
    "pred_sem Q (s(x1 := aval a s))"
