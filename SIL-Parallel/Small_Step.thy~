lemma star_sER: "(SKIP, sER s) \<rightarrow>* (SKIP, sER s)"
  by auto

lemma star_seq2_sOK: "(c1, sOK s) \<rightarrow>* (c1', sOK s') \<Longrightarrow> (c1;;c2, sOK s) \<rightarrow>* (c1';;c2, sOK s')"
proof(induction "(c1, sOK s)" "(c1', sOK s')" arbitrary: c1 s rule: star.induct)
  case refl thus ?case by simp
next
  case (step x c1 s)
  obtain c1'' s'' where x_eq: "x = (c1'', sOK s'')" 
    by (metis ok_reachable_from_ok old.prod.exhaust step.hyps(2))
  thus ?case
    by (metis Seq2 star.simps step.hyps(1,3))
qed

lemma seq_sER_collapse: "(c1;;c2, sER s) \<rightarrow> (SKIP, sER s)"
  by auto

lemma seq_sER_collapse_star: "(c1;;c2, sER s) \<rightarrow>* (SKIP, sER s)"
  by auto

lemma seq_comp_sOK:
  "\<lbrakk> (c1, sOK s1) \<rightarrow>* (SKIP,sOK s2); (c2,sOK s2) \<rightarrow>* (SKIP,s3) \<rbrakk>
   \<Longrightarrow> (c1;;c2, sOK s1) \<rightarrow>* (SKIP,s3)"
  by (meson Seq1 star.step star_seq2_sOK star_trans)

lemma seq_comp_sER:
  "(c1, s) \<rightarrow>* (SKIP, sER s2) \<Longrightarrow> (c1;;c2, s) \<rightarrow>* (SKIP, sER s2)"
  apply (induction "(c1, s)" "(SKIP, sER s2)" arbitrary: c1 s rule: star.induct)
   apply simp
  apply(case_tac s)
  apply clarsimp
  defer
   apply clarsimp
  apply(case_tac b)
  using ok_reachable_from_ok apply blast
   defer
  apply(case_tac b)
  apply (metis Seq2 star.step)
   apply (meson Seq2 star.step)
  apply clarsimp 
  by (smt (verit) Pair_inject sPost.distinct(1) seq_sER_collapse_star small_step.simps
      star.cases)

lemma sequential_imp:
  "(c, sOK s) \<rightarrow> (c', sOK s') \<Longrightarrow> isSequential c \<Longrightarrow> isSequential c'"
  apply (induction "(c, sOK s)" "(c', sOK s')" arbitrary: c s c' s' rule: small_step.induct)
    by fastforce+

lemma small_to_big_single_ok:
  assumes "isSequential c"
  shows "(c, sOK s) \<rightarrow> (SKIP, sOK s') \<Longrightarrow>  (c, s) \<Down> (s', True)"
  apply (cases rule: small_step.cases)
  apply blast+
  using assms apply auto[1]
  using assms apply auto[1]
by blast+

lemma small_to_big_single_er:
  assumes "isSequential c"
  shows "(c, sOK s) \<rightarrow> (SKIP, sER s') \<Longrightarrow> (c, s) \<Down> (s', False)"
  apply (cases rule: small_step.cases)
  by blast+   

lemma small_to_big_step_ok:
  assumes  "(c, sOK s) \<rightarrow> (c', sOK s')"
      and  "(c', s') \<Down> (t,True)"
      and "isSequential c"
    shows "(c,s) \<Down> (t,True)"
  using assms
  apply (induction "(c, sOK s)" "(c', sOK s')" arbitrary: c c' s s' t  rule: small_step.induct)
               apply fast
              apply fast
             apply fast
            apply fast
            defer
           apply simp
          apply force
         apply force
        apply fastforce
       apply fastforce
      apply fastforce
     apply blast
    apply blast
   apply fast
  apply clarsimp
by blast

lemma small_to_big_step_er:
  assumes  "(c, sOK s) \<rightarrow> (c', sOK s')"
      and  "(c', s') \<Down> (t,False)"
      and "isSequential c"
    shows "(c,s) \<Down> (t,False)"
  using assms
  apply (induction "(c, sOK s)" "(c', sOK s')" arbitrary: c c' s s' t  rule: small_step.induct)
               apply fast
              apply fast
             apply fast
            apply fast
           defer
           apply force
          apply simp
         apply simp
        apply simp
       apply blast
      apply fast
     apply blast
    apply blast
   apply blast
  by (metis (no_types, lifting) Big_Step.SeqE SeqFalse SeqTrue isSequential.simps(2)
      small_to_big_step_ok)

lemma small_to_big_step:
  assumes  "(c, sOK s) \<rightarrow> (c', sOK s')"
      and  "(c', s') \<Down> ta"
      and "isSequential c"
    shows "(c,s) \<Down> ta"
  using small_to_big_step_ok small_to_big_step_er assms
by (metis (full_types) old.prod.exhaust)


lemma small_to_big_ok:
  "(c, sOK s) \<rightarrow>* (SKIP, sOK t) \<Longrightarrow> 
   isSequential c \<Longrightarrow> 
   (c,s) \<Down> (t,True)"
proof (induction "(c, sOK s)" "(SKIP,sOK t)" arbitrary: c s rule: star.induct)
  case refl
  then show ?case by blast
next
  case (step y)
  then show ?case proof-
    obtain c' s' where x_eq: "y = (c', sOK s')"
      by (metis ok_reachable_from_ok old.prod.exhaust step.hyps(2))
   then show ?case
     using sequential_imp small_to_big_step step.hyps(1,3) step.prems by blast
 qed
qed

lemma instant_er_eq:
  "(c, sER s) \<rightarrow>* (SKIP, sER t) \<Longrightarrow>
  isSequential c \<Longrightarrow>
  t = s"
by (smt (verit) Pair_inject sPost.distinct(1) sPost.inject(2) small_step.simps
      star.cases)

lemma pure_er: "
  (c, sOK x) \<rightarrow> (c', sER t) \<Longrightarrow> 
  (c', sER t) \<rightarrow>* (SKIP, sER t) \<Longrightarrow> 
  isSequential c \<Longrightarrow> 
  (c, x) \<Down> (t, False)"
  apply (induction "(c, sOK x)" "(c', sER t)" arbitrary: c x c' t rule: small_step.induct)
  apply fast
  by auto

lemma small_to_big_er_start:"
  (c, sOK s) \<rightarrow> (c', sER s') \<Longrightarrow> 
  isSequential c \<Longrightarrow> 
  (c,s) \<Down> (s', False)"
using pure_er small_to_big_single_er by blast
 

lemma small_to_big_er:"
  (c, q) \<rightarrow>* (SKIP, sER t) \<Longrightarrow> 
  isSequential c \<Longrightarrow> 
  case q of
    sOK s \<Rightarrow> (c,s) \<Down> (t,False)
    | sER s \<Rightarrow> s = t"
  apply (induction "(c, q)" "(SKIP,sER t)" arbitrary: c q rule: star.induct)
   apply clarsimp
  apply (case_tac q)
   apply clarsimp
   apply (case_tac b)
    apply clarsimp
  using small_to_big_step_er apply (simp add: sequential_imp)
   apply (case_tac q)
    apply clarsimp
  using small_to_big_er_start
  apply (smt (verit) Small_Step.SkipE sPost.distinct(1) prod.inject small_step.cases
      star.simps)
   apply clarsimp
  using small_to_big_er_start
  apply (smt (verit) Pair_inject Small_Step.SkipE sPost.distinct(1) small_step.cases
      star.simps)
   apply (cases q)
     apply clarsimp
  apply (metis instant_er_eq star.step)
  apply clarsimp
by (metis instant_er_eq star.step)



text\<open>The following proof corresponds to one on the board where one would
show chains of \<open>\<rightarrow>\<close> and \<open>\<rightarrow>*\<close> steps.\<close>

lemma while_true_step:
  assumes hb: "bval b s\<^sub>1"
  assumes hbig1: "(c, s\<^sub>1) \<Down> (s\<^sub>2, True)"
  assumes hsmall1: "(c, sOK s\<^sub>1) \<rightarrow>* (SKIP, sOK s\<^sub>2)"
  assumes hbig2: "(WHILE b DO c, s\<^sub>2) \<Down> (t, True)"
  assumes hsmall2: "(WHILE b DO c, sOK s\<^sub>2) \<rightarrow>* (SKIP, sOK t)"
  assumes hseq: "isSequential c"
  shows "(WHILE b DO c, sOK s\<^sub>1) \<rightarrow>* (SKIP, sOK t)" 
by (meson While hb hsmall1 hsmall2 seq_comp_sOK small_step.IfTrue star.step)

lemma big_to_small_ok:
  "(c, s) \<Down> (t,True) \<Longrightarrow> isSequential c \<Longrightarrow> (c, sOK s) \<rightarrow>* (SKIP, sOK t)"
  apply (induction "(c, s)" "(t,True)"  arbitrary: c s t rule: big_step.induct)
  apply fastforce
              apply fastforce
             apply fastforce
            apply fastforce
           apply fastforce
          apply (metis isSequential.simps(2) seq_comp_sOK)
         apply fastforce
        apply (meson isSequential.simps(3) small_step.IfTrue star.step)
       apply (metis isSequential.simps(3) small_step.IfFalse star.step)
      apply (meson sequential_imp small_step.SelectND star.step)
     apply blast
    apply (metis While small_step.IfFalse star.simps)
   defer
   apply blast
  apply clarsimp
by (metis while_true_step)

lemma big_to_small_er:
  "(c, s) \<Down> (t,False) \<Longrightarrow> isSequential c \<Longrightarrow> (c, sOK s) \<rightarrow>* (SKIP, sER t)"
  apply (induction "(c, s)" "(t,False)"  arbitrary: c s t rule: big_step.induct)
  apply fastforce
              apply fastforce
             apply fastforce
            apply fastforce
           apply (metis small_step.Abort small_step.AssignNDEmpty star.simps)
          apply (metis isSequential.simps(2) seq_comp_sOK big_to_small_ok)
         apply (metis isSequential.simps(2) seq_comp_sER)
        apply (metis isSequential.simps(3) small_step.IfTrue star.step)
       apply (meson isSequential.simps(3) small_step.IfFalse star.step)
      apply (metis sequential_imp small_step.SelectND star.step)
     apply (metis SelectNDN small_step.Abort star.simps)
    apply simp
  apply (meson While big_to_small_ok isSequential.simps(4) seq_comp_sOK small_step.IfTrue
      star.step)
by (metis While isSequential.simps(4) seq_comp_sER small_step.IfTrue star.simps)
         

text \<open>
  Finally, the equivalence theorem:
\<close>

theorem big_iff_small:
  assumes "isSequential c"
  shows "(c,s) \<Down> (t, True) = (c,sOK s) \<rightarrow>* (SKIP,sOK t)"
  and "(c,s) \<Down> (t, False) = (c,sOK s) \<rightarrow>* (SKIP,sER t)"
  using assms big_to_small_ok small_to_big_ok apply blast
by (metis assms big_to_small_er sPost.simps(5) small_to_big_er)


subsection "Final configurations and infinite reductions"

definition "final cs \<longleftrightarrow> \<not>(\<exists>cs'. cs \<rightarrow> cs')"

lemma finalD_ok: "final (c,sOK s) \<Longrightarrow> c = SKIP"
apply(simp add: final_def)
  apply(induction c)
         apply blast
        apply blast
       apply blast
       defer
      apply blast
     apply blast
    apply blast
    apply blast
  defer
  apply (metis ex_in_conv small_step.AssignND small_step.AssignNDEmpty)
  by blast

lemma finalD_er: "final (c,sER s) \<Longrightarrow> c = SKIP"
apply(simp add: final_def)
  apply(induction c) by blast+

lemma finalD: "final (c,s) \<Longrightarrow> c = SKIP"
  by (metis finalD_er finalD_ok sPost.exhaust)

lemma final_iff_SKIP: "final (c,s) = (c = SKIP)"
by (metis SkipE finalD final_def)

text\<open>Now we can show that \<open>\<Rightarrow>\<close> yields a final state iff \<open>\<rightarrow>\<close>
terminates:\<close>
