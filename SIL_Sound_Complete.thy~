subsubsection "Soundness"

lemma sil_sound_while:
   "\<lbrakk>\<turnstile> \<langle>\<lambda>s. P s \<and> bval b s\<rangle> c  \<langle>\<lambda>s. P s\<rangle>; \<forall>s. P s \<and> bval b s \<longrightarrow> (\<exists>t. (c, s) \<Rightarrow> t \<and> P t)\<rbrakk>
       \<Longrightarrow> \<forall>s. P s \<longrightarrow> (\<exists>t. (WHILE b DO c, s) \<Rightarrow> t \<and> P t \<and> \<not> bval b t)"

proof -
  have "(WHILE b DO c,s) \<Rightarrow> t  \<Longrightarrow>  P s  \<Longrightarrow>  P t \<and> \<not> bval b t" for s t
  proof(induction "WHILE b DO c" s t rule: big_step_induct)
    case WhileFalse thus ?case by blast
  next
    case WhileTrue thus ?case sledgehammer
      sorry
  qed
  thus ?thesis unfolding SIL_valid_def sorry
qed

